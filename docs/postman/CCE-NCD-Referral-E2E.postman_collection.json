    {
      "name": "4. Diagnosis — Type 2 Diabetes (SPICE → Adaptor)",
      "item": [
        {
          "name": "4a. Create Condition (T2DM)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "var result = json.results[0];",
                  "",
                  "pm.test('Condition created', function () {",
                  "    pm.expect(result.status).to.eql('created');",
                  "});",
                  "",
                  "if (result.resourceId) {",
                  "    pm.collectionVariables.set('condition_uuid', result.resourceId);",
                  "    console.log('Condition UUID: ' + result.resourceId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/fhir+json" },
              { "key": "X-Source-System", "value": "spice" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resourceType\": \"Condition\",\n  \"clinicalStatus\": {\n    \"coding\": [{\n      \"system\": \"http://terminology.hl7.org/CodeSystem/condition-clinical\",\n      \"code\": \"active\"\n    }]\n  },\n  \"verificationStatus\": {\n    \"coding\": [{\n      \"system\": \"http://terminology.hl7.org/CodeSystem/condition-ver-status\",\n      \"code\": \"confirmed\"\n    }]\n  },\n  \"code\": {\n    \"coding\": [{\n      \"system\": \"http://ciel.org\",\n      \"code\": \"142473AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\n      \"display\": \"Diabetes mellitus, type 2\"\n    }]\n  },\n  \"subject\": {\n    \"reference\": \"Patient/{{patient_uuid}}\"\n  },\n  \"encounter\": {\n    \"reference\": \"Encounter/{{ncd_encounter_uuid}}\"\n  },\n  \"onsetDateTime\": \"2026-04-05T09:00:00+02:00\",\n  \"recorder\": {\n    \"reference\": \"Practitioner/1fee2f21-82f3-4aab-8d87-f1cf19034649\",\n    \"display\": \"Jane Nurse\"\n  }\n}"
            },
            "url": {
              "raw": "{{adaptor_base_url}}",
              "host": ["{{adaptor_base_url}}"]
            },
            "description": "Diagnosis: Type 2 Diabetes Mellitus (CIEL 142473). The adaptor resolves the concept code and auto-fills recordedDate if missing."
          }
        }
      ]
    },
    {
      "name": "5. Lab Referral — ServiceRequest + Task (SPICE → Adaptor)",
      "item": [
        {
          "name": "5a. Create ServiceRequest (HbA1c Lab Order)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "var result = json.results[0];",
                  "",
                  "pm.test('ServiceRequest created via REST', function () {",
                  "    pm.expect(result.status).to.be.oneOf(['created', 'updated']);",
                  "    pm.expect(result.route).to.eql('rest');",
                  "});",
                  "",
                  "if (result.resourceId) {",
                  "    pm.collectionVariables.set('service_request_uuid', result.resourceId);",
                  "    console.log('ServiceRequest UUID: ' + result.resourceId);",
                  "    console.log('Route: ' + result.route + ' (REST because O3 FHIR is read-only for ServiceRequest)');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/fhir+json" },
              { "key": "X-Source-System", "value": "spice" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resourceType\": \"ServiceRequest\",\n  \"status\": \"active\",\n  \"intent\": \"order\",\n  \"priority\": \"urgent\",\n  \"code\": {\n    \"coding\": [{\n      \"code\": \"159644AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\n      \"display\": \"Glycosylated hemoglobin A measurement (HbA1c)\"\n    }]\n  },\n  \"subject\": {\n    \"reference\": \"Patient/{{patient_uuid}}\",\n    \"display\": \"MUGISHA JEAN PAUL\"\n  },\n  \"encounter\": {\n    \"reference\": \"Encounter/{{ncd_encounter_uuid}}\"\n  },\n  \"requester\": {\n    \"reference\": \"Practitioner/1fee2f21-82f3-4aab-8d87-f1cf19034649\",\n    \"display\": \"Jane Nurse\"\n  },\n  \"note\": [{\n    \"text\": \"Fasting glucose 310 mg/dL. Urgent HbA1c needed to confirm uncontrolled diabetes.\"\n  }]\n}"
            },
            "url": {
              "raw": "{{adaptor_base_url}}",
              "host": ["{{adaptor_base_url}}"]
            },
            "description": "HbA1c lab order. The adaptor routes this via REST API (POST /order as TestOrder) because O3's FHIR endpoint only supports read/search for ServiceRequest.\n\nFhirToRestTransformer maps:\n- code.coding[0].code → concept\n- encounter.reference → encounter UUID\n- subject.reference → patient UUID\n- requester.reference → orderer UUID\n- priority → urgency (urgent → STAT)\n- careSetting → OUTPATIENT (hardcoded)\n- type → testorder (hardcoded)"
          }
        },
        {
          "name": "5b. Verify ServiceRequest in O3",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{openmrs_user}}" },
                { "key": "password", "value": "{{openmrs_pass}}" }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{openmrs_fhir_url}}/ServiceRequest?patient={{patient_uuid}}&_sort=-_lastUpdated&_count=1",
              "host": ["{{openmrs_fhir_url}}"],
              "path": ["ServiceRequest"],
              "query": [
                { "key": "patient", "value": "{{patient_uuid}}" },
                { "key": "_sort", "value": "-_lastUpdated" },
                { "key": "_count", "value": "1" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('ServiceRequest found in O3', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.total).to.be.above(0);",
                  "    var sr = json.entry[0].resource;",
                  "    console.log('ServiceRequest: ' + sr.id + ' | status: ' + sr.status + ' | intent: ' + sr.intent);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "5c. Create Task (Referral Tracking)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "var result = json.results[0];",
                  "",
                  "pm.test('Task created via FHIR', function () {",

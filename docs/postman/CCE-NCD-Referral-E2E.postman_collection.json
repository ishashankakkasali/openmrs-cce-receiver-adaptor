{
  "info": {
    "name": "CCE NCD Referral — E2E (SPICE → Adaptor → O3)",
    "description": "End-to-end NCD referral workflow: Patient registration → NCD screening → Lab referral → Lab results → Task completion.\n\nAll requests go through the CCE Receiver Adaptor at localhost:8083, which enriches and routes them to OpenMRS O3.\n\n**Run requests in order** — each step depends on UUIDs from previous steps.\n\nAfter each step, copy the returned `resourceId` into the collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "adaptor_base_url",
      "value": "http://localhost:8083/api/v1/fhir",
      "type": "string"
    },
    {
      "key": "openmrs_fhir_url",
      "value": "http://localhost:9096/openmrs/ws/fhir2/R4",
      "type": "string"
    },
    {
      "key": "openmrs_rest_url",
      "value": "http://localhost:9096/openmrs/ws/rest/v1",
      "type": "string"
    },
    {
      "key": "openmrs_user",
      "value": "admin",
      "type": "string"
    },
    {
      "key": "openmrs_pass",
      "value": "Admin123",
      "type": "string"
    },
    {
      "key": "patient_uuid",
      "value": "26922e36-e154-4648-b168-f65999a54c69",
      "type": "string"
    },
    {
      "key": "ncd_encounter_uuid",
      "value": "1c804497-689b-4dc0-a029-d1134c2acc0e",
      "type": "string"
    },
    {
      "key": "systolic_obs_uuid",
      "value": "dcb85b5e-5407-4d00-b306-66c8a543dead",
      "type": "string"
    },
    {
      "key": "diastolic_obs_uuid",
      "value": "52265681-2539-4f49-b4b7-ffb4dd1d9353",
      "type": "string"
    },
    {
      "key": "glucose_obs_uuid",
      "value": "a8a572b0-8d8f-458d-989d-315591bf6f42",
      "type": "string"
    },
    {
      "key": "condition_uuid",
      "value": "93a76e1e-74ac-4c0b-98a3-11ed830f7ef2",
      "type": "string"
    },
    {
      "key": "service_request_uuid",
      "value": "fbcdcabf-940d-40d2-b1bc-9d6b4d4e681f",
      "type": "string"
    },
    {
      "key": "task_uuid",
      "value": "af47af61-32a8-4609-953e-8ca3c132a3a6",
      "type": "string"
    },
    {
      "key": "lab_encounter_uuid",
      "value": "428b68dd-2da0-440b-b9e8-5ace28c541b1",
      "type": "string"
    },
    {
      "key": "hba1c_obs_uuid",
      "value": "1b07d1da-0423-4cc9-acf7-e0eaefcd7576",
      "type": "string"
    },
    {
      "key": "diagnostic_report_uuid",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "noauth"
  },
  "item": [
    {
      "name": "0. Health Checks",
      "item": [
        {
          "name": "0a. CCE Adaptor Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8083/actuator/health",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8083",
              "path": ["actuator", "health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Adaptor is UP', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('UP');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "0b. OpenMRS O3 Health",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{openmrs_user}}" },
                { "key": "password", "value": "{{openmrs_pass}}" }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{openmrs_fhir_url}}/metadata",
              "host": ["{{openmrs_fhir_url}}"],
              "path": ["metadata"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('O3 FHIR endpoint is reachable', function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "0c. Adaptor Routing Table",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8083/api/v1/routing-table",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8083",
              "path": ["api", "v1", "routing-table"]
            }
          }
        }
      ]
    },
    {
      "name": "1. Register Patient (SPICE → Adaptor)",
      "item": [
        {
          "name": "1a. Create Patient",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "var result = json.results[0];",
                  "",
                  "pm.test('Patient created successfully', function () {",
                  "    pm.expect(result.status).to.be.oneOf(['created', 'updated']);",
                  "    pm.expect(result.resourceId).to.not.be.null;",
                  "});",
                  "",
                  "if (result.resourceId) {",
                  "    pm.collectionVariables.set('patient_uuid', result.resourceId);",
                  "    console.log('Patient UUID: ' + result.resourceId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/fhir+json" },
              { "key": "X-Source-System", "value": "spice" },
              { "key": "X-Correlation-ID", "value": "ncd-referral-demo-001" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resourceType\": \"Patient\",\n  \"name\": [\n    {\n      \"use\": \"official\",\n      \"family\": \"MUGISHA\",\n      \"given\": [\"JEAN\", \"PAUL\"]\n    }\n  ],\n  \"gender\": \"male\",\n  \"birthDate\": \"1985-03-15\",\n  \"identifier\": [\n    {\n      \"system\": \"NID\",\n      \"value\": \"1198503150001234\"\n    },\n    {\n      \"system\": \"UPI\",\n      \"value\": \"040505-0001-1234\"\n    }\n  ],\n  \"address\": [\n    {\n      \"use\": \"home\",\n      \"city\": \"Kigali\",\n      \"district\": \"Gasabo\",\n      \"country\": \"Rwanda\"\n    }\n  ],\n  \"telecom\": [\n    {\n      \"system\": \"phone\",\n      \"value\": \"+250788123456\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{adaptor_base_url}}",
              "host": ["{{adaptor_base_url}}"]
            },
            "description": "Register a new patient from SPICE. The adaptor will:\n- Generate an OpenMRS ID with LuhnMod30 check digit\n- Promote NID and UPI identifiers with type.text\n- Add location extension to identifiers\n- Add UUID ids to all sub-elements"
          }
        },
        {
          "name": "1b. Verify Patient in O3",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{openmrs_user}}" },
                { "key": "password", "value": "{{openmrs_pass}}" }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{openmrs_fhir_url}}/Patient/{{patient_uuid}}",
              "host": ["{{openmrs_fhir_url}}"],
              "path": ["Patient", "{{patient_uuid}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Patient exists in O3', function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "    var patient = pm.response.json();",
                  "    pm.expect(patient.resourceType).to.eql('Patient');",
                  "    console.log('Patient: ' + patient.name[0].family + ' ' + patient.name[0].given.join(' '));",
                  "    patient.identifier.forEach(function(id) {",
                  "        console.log('  ID: ' + (id.type ? id.type.text : 'unknown') + ' = ' + id.value);",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. NCD Screening Encounter (SPICE → Adaptor)",
      "item": [
        {
          "name": "2a. Create NCD Encounter",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "var result = json.results[0];",
                  "",
                  "pm.test('Encounter created', function () {",
                  "    pm.expect(result.status).to.eql('created');",
                  "    pm.expect(result.resourceId).to.not.be.null;",
                  "});",
                  "",
                  "if (result.resourceId) {",
                  "    pm.collectionVariables.set('ncd_encounter_uuid', result.resourceId);",
                  "    console.log('NCD Encounter UUID: ' + result.resourceId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/fhir+json" },
              { "key": "X-Source-System", "value": "spice" },
              { "key": "X-Correlation-ID", "value": "ncd-referral-demo-001" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resourceType\": \"Encounter\",\n  \"meta\": {\n    \"tag\": [{\"system\": \"http://fhir.openmrs.org/ext/encounter-tag\", \"code\": \"encounter\", \"display\": \"Encounter\"}]\n  },\n  \"status\": \"finished\",\n  \"class\": {\n    \"system\": \"http://terminology.hl7.org/CodeSystem/v3-ActCode\",\n    \"code\": \"AMB\",\n    \"display\": \"Ambulatory\"\n  },\n  \"type\": [{\n    \"coding\": [{\n      \"system\": \"http://fhir.openmrs.org/code-system/encounter-type\",\n      \"code\": \"d7151f82-c1f3-4152-a605-2f9ea7414a79\",\n      \"display\": \"Visit Note\"\n    }]\n  }],\n  \"subject\": {\n    \"reference\": \"Patient/{{patient_uuid}}\",\n    \"type\": \"Patient\"\n  },\n  \"period\": {\n    \"start\": \"2026-04-05T09:00:00+02:00\"\n  },\n  \"location\": [{\n    \"location\": {\n      \"reference\": \"Location/44c3efb0-2583-4c80-a79e-1f756a03c0a1\",\n      \"display\": \"Outpatient Clinic\"\n    }\n  }],\n  \"participant\": [{\n    \"individual\": {\n      \"reference\": \"Practitioner/1fee2f21-82f3-4aab-8d87-f1cf19034649\",\n      \"display\": \"Jane Nurse\"\n    }\n  }]\n}"
            },
            "url": {
              "raw": "{{adaptor_base_url}}",
              "host": ["{{adaptor_base_url}}"]
            },
            "description": "Create the NCD screening encounter at Outpatient Clinic. The adaptor will:\n- Resolve encounter type by UUID\n- Auto-fill period if missing\n- Add UUID ids to sub-elements (location, participant, type)"
          }
        }
      ]
    },
    {
      "name": "3. NCD Observations — Vitals & Lab (SPICE → Adaptor)",
      "item": [
        {
          "name": "3a. Systolic Blood Pressure (155 mmHg)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "var result = json.results[0];",
                  "",
                  "pm.test('Systolic BP created', function () {",
                  "    pm.expect(result.status).to.eql('created');",
                  "});",
                  "",
                  "if (result.resourceId) {",
                  "    pm.collectionVariables.set('systolic_obs_uuid', result.resourceId);",
                  "    console.log('Systolic BP Obs UUID: ' + result.resourceId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/fhir+json" },
              { "key": "X-Source-System", "value": "spice" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resourceType\": \"Observation\",\n  \"status\": \"final\",\n  \"code\": {\n    \"coding\": [{\n      \"system\": \"http://ciel.org\",\n      \"code\": \"5085AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\n      \"display\": \"Systolic blood pressure\"\n    }]\n  },\n  \"subject\": {\n    \"reference\": \"Patient/{{patient_uuid}}\"\n  },\n  \"encounter\": {\n    \"reference\": \"Encounter/{{ncd_encounter_uuid}}\"\n  },\n  \"effectiveDateTime\": \"2026-04-05T09:15:00+02:00\",\n  \"valueQuantity\": {\n    \"value\": 155,\n    \"unit\": \"mmHg\",\n    \"system\": \"http://unitsofmeasure.org\",\n    \"code\": \"mm[Hg]\"\n  }\n}"
            },
            "url": {
              "raw": "{{adaptor_base_url}}",
              "host": ["{{adaptor_base_url}}"]
            },
            "description": "Systolic BP = 155 mmHg (elevated). Uses CIEL concept 5085. The adaptor resolves the concept code to OpenMRS UUID."
          }
        },

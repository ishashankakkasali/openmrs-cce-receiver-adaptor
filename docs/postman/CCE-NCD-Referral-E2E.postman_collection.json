                  "    pm.collectionVariables.set('diastolic_obs_uuid', result.resourceId);",
                  "    console.log('Diastolic BP Obs UUID: ' + result.resourceId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/fhir+json" },
              { "key": "X-Source-System", "value": "spice" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resourceType\": \"Observation\",\n  \"status\": \"final\",\n  \"code\": {\n    \"coding\": [{\n      \"system\": \"http://ciel.org\",\n      \"code\": \"5086AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\n      \"display\": \"Diastolic blood pressure\"\n    }]\n  },\n  \"subject\": {\n    \"reference\": \"Patient/{{patient_uuid}}\"\n  },\n  \"encounter\": {\n    \"reference\": \"Encounter/{{ncd_encounter_uuid}}\"\n  },\n  \"effectiveDateTime\": \"2026-04-05T09:15:00+02:00\",\n  \"valueQuantity\": {\n    \"value\": 95,\n    \"unit\": \"mmHg\",\n    \"system\": \"http://unitsofmeasure.org\",\n    \"code\": \"mm[Hg]\"\n  }\n}"
            },
            "url": {
              "raw": "{{adaptor_base_url}}",
              "host": ["{{adaptor_base_url}}"]
            },
            "description": "Diastolic BP = 95 mmHg. Uses CIEL concept 5086."
          }
        },
        {
          "name": "3c. Fasting Blood Glucose (310 mg/dL — HIGH)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "var result = json.results[0];",
                  "",
                  "pm.test('Fasting Glucose created', function () {",
                  "    pm.expect(result.status).to.eql('created');",
                  "});",
                  "",
                  "if (result.resourceId) {",
                  "    pm.collectionVariables.set('glucose_obs_uuid', result.resourceId);",
                  "    console.log('Glucose Obs UUID: ' + result.resourceId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/fhir+json" },
              { "key": "X-Source-System", "value": "spice" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resourceType\": \"Observation\",\n  \"status\": \"final\",\n  \"code\": {\n    \"coding\": [{\n      \"system\": \"http://loinc.org\",\n      \"code\": \"1558-6\",\n      \"display\": \"Fasting glucose\"\n    }]\n  },\n  \"subject\": {\n    \"reference\": \"Patient/{{patient_uuid}}\"\n  },\n  \"encounter\": {\n    \"reference\": \"Encounter/{{ncd_encounter_uuid}}\"\n  },\n  \"effectiveDateTime\": \"2026-04-05T09:20:00+02:00\",\n  \"valueQuantity\": {\n    \"value\": 310,\n    \"unit\": \"mg/dL\",\n    \"system\": \"http://unitsofmeasure.org\",\n    \"code\": \"mg/dL\"\n  }\n}"
            },
            "url": {
              "raw": "{{adaptor_base_url}}",
              "host": ["{{adaptor_base_url}}"]
